# Configuración del Sitio / Site Configuration
# Copia este archivo a .env y completa los valores

# Nombre del sitio / Site name
VITE_SITE_NAME=DevPortfolio

# Información del propietario / Owner information
VITE_OWNER_NAME=Tu Nombre
VITE_OWNER_TITLE=Desarrollador Full Stack

# Contacto / Contact
VITE_CONTACT_EMAIL=tu@email.com
VITE_CONTACT_PHONE=+58 123 456 7890

# Ubicación / Location
VITE_LOCATION=Venezuela
VITE_EXPERIENCE=5+ años de experiencia

# Proyectos completados / Completed projects
VITE_PROJECTS_COMPLETED=50+

# Redes sociales / Social networks
VITE_GITHUB_URL=https://github.com/tu-usuario
VITE_LINKEDIN_URL=https://linkedin.com/in/tu-perfil
VITE_TWITTER_URL=https://twitter.com/tu-usuario

# API / Backend
VITE_API_URL=http://localhost:8000
VITE_API_CONTACT_ENDPOINT=/api/contacto/
